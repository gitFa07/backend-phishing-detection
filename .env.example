# Copy to .env for local use, or set these in your hosting dashboard.
# Every value shown is the default unless noted.

# Comma-separated list of origins allowed to call the API from a browser.
# Use the exact origin of your hosted frontend: scheme + host, no path, no trailing slash.
CORS_ALLOW_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Requests per minute per client for /predict, and a stricter limit for deep scans. 0 disables.
RATE_LIMIT_PER_MINUTE=30
DEEP_SCAN_RATE_LIMIT_PER_MINUTE=6

# How many reverse proxies sit in front of the app (hosting platforms usually add 1).
# Leave at 0 when running locally. See DEPLOYMENT.md before changing it.
TRUSTED_PROXY_COUNT=0

LOG_LEVEL=INFO

# Set to false to skip loading SHAP (saves memory; responses then have no explanation).
ENABLE_EXPLANATIONS=true

# Set to false to refuse server-side visits to submitted sites entirely.
ENABLE_DEEP_SCAN=true
DEEP_SCAN_TIMEOUT_SECONDS=10

# Optional: Google Safe Browsing API key, used only by deep scans.
# SAFE_BROWSING_API_KEY=
